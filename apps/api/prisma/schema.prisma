generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_MORE_INFO
}

enum IncidentType {
  WASTE
  WATER_POLLUTION
  AIR_POLLUTION
  ENVIRONMENTAL_DESTRUCTION
  OTHER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChallengeStatus {
  DRAFT
  OPEN
  CLOSED
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum GameType {
  HABITAT_MATCH
  FOREST_DETECTIVE
}

model User {
  id                String                @id @default(cuid())
  email             String                @unique
  passwordHash      String
  name              String
  role              Role                  @default(STUDENT)
  status            AccountStatus         @default(ACTIVE)
  points            Int                   @default(0)
  reports           PollutionReport[]
  submissions       ChallengeSubmission[]
  attempts          GameAttempt[]
  createdChallenges GreenChallenge[]      @relation("ChallengeCreator")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model DataSource {
  id             String          @id @default(cuid())
  title          String
  url            String
  license        String?
  accessedAt     DateTime?
  species        Species[]
  protectedAreas ProtectedArea[]
  createdAt      DateTime        @default(now())
}

model Species {
  id                 String                 @id @default(cuid())
  commonName         String
  scientificName     String                 @unique
  group              String?
  habitat            String?
  characteristics    String?
  conservationStatus String?
  sourceId           String?
  source             DataSource?            @relation(fields: [sourceId], references: [id])
  protectedAreas     ProtectedAreaSpecies[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model ProtectedArea {
  id                 String                 @id @default(cuid())
  name               String
  province           String
  latitude           Float
  longitude          Float
  areaKm2            Float?
  ecosystems         String[]
  description        String?
  conservationStatus String?
  imageUrl           String?
  sourceId           String?
  source             DataSource?            @relation(fields: [sourceId], references: [id])
  species            ProtectedAreaSpecies[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([province])
}

model ProtectedAreaSpecies {
  protectedAreaId String
  speciesId       String
  protectedArea   ProtectedArea @relation(fields: [protectedAreaId], references: [id], onDelete: Cascade)
  species         Species       @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@id([protectedAreaId, speciesId])
}

model AirQualityLocation {
  id                 String              @id @default(cuid())
  name               String
  latitude           Float
  longitude          Float
  provider           String
  providerLocationId String?
  readings           AirQualityReading[]

  @@index([latitude, longitude])
}

model AirQualityReading {
  id         String             @id @default(cuid())
  locationId String
  location   AirQualityLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  indexName  String
  value      Float
  category   String
  measuredAt DateTime
  sourceUrl  String
  createdAt  DateTime           @default(now())

  @@index([locationId, measuredAt])
}

model PollutionReport {
  id                    String             @id @default(cuid())
  authorId              String
  author                User               @relation(fields: [authorId], references: [id])
  title                 String
  description           String
  incidentType          IncidentType
  latitude              Float
  longitude             Float
  preciseLocationPublic Boolean            @default(false)
  status                ReportStatus       @default(PENDING)
  media                 ReportMedia[]
  moderation            ReportModeration[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([authorId])
}

model ReportMedia {
  id         String          @id @default(cuid())
  reportId   String
  report     PollutionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  storageKey String
  mimeType   String
  size       Int
  createdAt  DateTime        @default(now())
}

model ReportModeration {
  id        String          @id @default(cuid())
  reportId  String
  report    PollutionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  teacherId String
  action    ReportStatus
  reason    String
  createdAt DateTime        @default(now())

  @@index([reportId, createdAt])
}

model GreenChallenge {
  id                String                @id @default(cuid())
  creatorId         String
  creator           User                  @relation("ChallengeCreator", fields: [creatorId], references: [id])
  title             String
  description       String
  instructions      String
  proofInstructions String
  points            Int
  status            ChallengeStatus       @default(DRAFT)
  startsAt          DateTime
  endsAt            DateTime
  submissions       ChallengeSubmission[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, endsAt])
}

model ChallengeSubmission {
  id            String           @id @default(cuid())
  challengeId   String
  challenge     GreenChallenge   @relation(fields: [challengeId], references: [id])
  studentId     String
  student       User             @relation(fields: [studentId], references: [id])
  description   String
  status        ReviewStatus     @default(PENDING)
  reviewReason  String?
  awardedPoints Int              @default(0)
  reviewedById  String?
  media         ChallengeMedia[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([challengeId, studentId])
  @@index([status])
}

model ChallengeMedia {
  id           String              @id @default(cuid())
  submissionId String
  submission   ChallengeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  storageKey   String
  mimeType     String
  size         Int
}

model Game {
  id        String         @id @default(cuid())
  title     String
  type      GameType
  enabled   Boolean        @default(true)
  questions GameQuestion[]
  attempts  GameAttempt[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model GameQuestion {
  id          String         @id @default(cuid())
  gameId      String
  game        Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  prompt      String
  explanation String
  imageUrl    String?
  enabled     Boolean        @default(true)
  choices     AnswerChoice[]
  answers     GameAnswer[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model AnswerChoice {
  id         String       @id @default(cuid())
  questionId String
  question   GameQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean
}

model GameAttempt {
  id        String       @id @default(cuid())
  gameId    String
  game      Game         @relation(fields: [gameId], references: [id])
  studentId String
  student   User         @relation(fields: [studentId], references: [id])
  score     Int
  total     Int
  answers   GameAnswer[]
  createdAt DateTime     @default(now())

  @@index([studentId, createdAt])
}

model GameAnswer {
  id               String       @id @default(cuid())
  attemptId        String
  attempt          GameAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         GameQuestion @relation(fields: [questionId], references: [id])
  selectedChoiceId String
  correct          Boolean
}

model EducationalDocument {
  id         String          @id @default(cuid())
  title      String
  sourceUrl  String?
  license    String?
  storageKey String
  mimeType   String
  status     DocumentStatus  @default(PENDING)
  error      String?
  chunks     DocumentChunk[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model DocumentChunk {
  id         String              @id @default(cuid())
  documentId String
  document   EducationalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  position   Int
  @@unique([documentId, position])
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  sources   Json?
  createdAt DateTime    @default(now())
}

model SpeciesIdentification {
  id             String   @id @default(cuid())
  userId         String
  storageKey     String
  status         String
  predictionName String?
  confidence     Float?
  speciesId      String?
  provider       String?
  error          String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}
