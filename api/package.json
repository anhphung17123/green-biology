{
  "name": "@green-biology/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "seed:users": "node --env-file-if-exists=.env --import tsx scripts/seed-users.ts",
    "supabase:link": "supabase link --project-ref cpkvdecdzwxanjyhvehu",
    "supabase:deploy": "supabase functions deploy --remote=cpkvdecdzwxanjyhvehu --use-api --yes",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "supabase": "^3.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
